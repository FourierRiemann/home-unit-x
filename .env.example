# Copy to .env (setup-ubuntu.sh does this and fills in the IDs automatically)
TZ=Europe/Stockholm

# User/group that owns the files: `id -u` / `id -g`
PUID=1000
PGID=1000

# GID of the "render" group, needed for Quick Sync: `getent group render | cut -d: -f3`
RENDER_GID=993

# Media, photos, etc. (external drive)
DATA_PATH=/mnt/data

# App config and databases (internal SSD)
CONFIG_PATH=/opt/home-unit-x/config
